.DS_Store

# Scratch/disposable tuning output: logs, stderr dumps, superseded
# worksheet & taxonomy iterations, regenerated DBs.
/experiments/

# Real people's bookmark collections and the labeled worksheets derived from
# them. These contain actual URLs, page titles and browsing interests
# belonging to identifiable individuals. They stay on local disk and are
# never committed. Taxonomy JSON (folder names + rationales only) is fine.
/corpora/
/tuning/*.csv
/tuning/*.numbers
/tuning/run-data/

# UI reference screenshots of other apps. Kept locally: ~18MB of binaries
# that would live in history forever, and they aren't ours to redistribute.
/design/
